<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for MartBox's Electron helper processes (GPU/renderer/utility
  helpers that Chromium spawns as separate signed binaries inside the .app
  bundle). Referenced from electron-builder.yml as mas.entitlementsInherit.
  These processes don't serve the local Express server themselves, so no
  network.server entitlement here — only network.client, since the renderer
  makes fetch() calls to the local server and to TMDb.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!-- Inherits the parent app's sandbox container/permissions rather than
       running as an independent sandboxed process. -->
  <key>com.apple.security.inherit</key>
  <true/>

  <key>com.apple.security.network.client</key>
  <true/>

  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
