<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Main-process entitlements for the Mac App Store (MAS) build of MartBox.
  Referenced from electron-builder.yml as mas.entitlements. Electron's own
  MAS submission guide uses this exact main/inherit split for the app vs.
  its helper (renderer/GPU) processes:
  https://www.electronjs.org/docs/latest/tutorial/mac-app-store-submission-guide
-->
<plist version="1.0">
<dict>
  <!-- Required: every Mac App Store app must be sandboxed. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!-- Outbound HTTPS calls: TMDb metadata API, Tailscale admin API. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- The local Express server (127.0.0.1, random port) that streaming and
       image-cache requests are served from. -->
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Lets the user grant folder access via NSOpenPanel (Settings -> Add
       Library Folder). Required instead of raw filesystem access. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Persists that grant as a security-scoped bookmark so previously-added
       library folders remain accessible across app relaunches without
       re-prompting the user every time. -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>

  <!-- Electron/V8 needs JIT and unsigned executable memory even inside the
       sandbox; native Node modules (better-sqlite3) need library validation
       disabled because they aren't signed by Apple. All three are standard
       requirements for any sandboxed Electron app, not MartBox-specific. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
